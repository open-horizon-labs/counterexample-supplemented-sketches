     return False\n \n \n@@ -189,8 +197,9 @@\n     if op == \"in\":\n         return _norm(actual) in _split_csv(value)\n     if op in {\"gte\", \"lte\"}:\n-        av = _ordinal_value(actual, LEVELS if attr in {\"energy\", \"shedding\", \"grooming\", \"sociability\", \"vocal\", \"affection\"} else SIZES)\n-        cv = _ordinal_value(value, LEVELS if attr in {\"energy\", \"shedding\", \"grooming\", \"sociability\", \"vocal\", \"affection\"} else SIZES)\n+        scale = LEVELS if attr in {\"energy\", \"shedding\", \"grooming\", \"sociability\", \"vocal\", \"affection\"} else SIZES\n+        av = _ordinal_value(actual, scale)\n+        cv = _ordinal_value(value, scale)\n         if av is None or cv is None:\n             return False\n         return av >= cv if op == \"gte\" else av <= cv\n"
